// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PROFESSOR
  ALUNO
}

model Dojo {
  id                 String    @id @default(uuid())
  name               String
  president          String
  cnpj               String?   @unique
  
  defaultShihan      String?
  defaultSensei      String?
  defaultAssociation String?
  logoPrimaryUrl     String?
  logoSecondaryUrl   String?
  city               String?
  showShihanText     Boolean   @default(false)
  showKanjiText      Boolean   @default(false)
    diplomaBackground  String    @default("sunset")
  diplomaBackgroundImageUrl String?
  
  users              User[]
  ranks              Rank[]
  students           Student[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?
  
  createdByUser User? @relation("DojoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser User? @relation("DojoUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model User {
  id          String    @id @default(uuid())
  dojoId      String
  name        String
  email       String    @unique
  password    String
  role        Role      @default(ALUNO)
  
  dojo        Dojo      @relation(fields: [dojoId], references: [id], onDelete: Restrict)
  studentProfile Student? @relation("UserToStudent")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  dojosCreated          Dojo[]            @relation("DojoCreatedBy")
  dojosUpdated          Dojo[]            @relation("DojoUpdatedBy")
  
  ranksCreated          Rank[]            @relation("RankCreatedBy")
  ranksUpdated          Rank[]            @relation("RankUpdatedBy")
  
  studentsCreated       Student[]         @relation("StudentCreatedBy")
  studentsUpdated       Student[]         @relation("StudentUpdatedBy")
  
  attendancesCreated    Attendance[]      @relation("AttendanceCreatedBy")
  attendancesUpdated    Attendance[]      @relation("AttendanceUpdatedBy")
  
  transfersCreated      TransferHistory[] @relation("TransferCreatedBy")
  transfersUpdated      TransferHistory[] @relation("TransferUpdatedBy")
  
  certificatesCreated   Certificate[]     @relation("CertificateCreatedBy")
  certificatesUpdated   Certificate[]     @relation("CertificateUpdatedBy")
}

model Rank {
  id          String    @id @default(uuid())
  dojoId      String
  name        String
  color       String
  phrase      String?
  minHours    Int       @default(0)
  minDays     Int       @default(0)
  sortOrder   Int       @default(0)

  dojo        Dojo      @relation(fields: [dojoId], references: [id], onDelete: Restrict)
  students    Student[]
  certificates Certificate[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  createdByUser User?   @relation("RankCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser User?   @relation("RankUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Student {
  id                String    @id @default(uuid())
  dojoId            String
  userId            String?   @unique
  currentRankId     String?
  name              String
  
  birthDate         DateTime?
  phone             String?
  emergencyContact  String?
  medicalNotes      String?
  
  hasFinancialDebts Boolean   @default(false)
  joinedAt          DateTime  @default(now())

  dojo              Dojo      @relation(fields: [dojoId], references: [id], onDelete: Restrict)
  user              User?     @relation("UserToStudent", fields: [userId], references: [id], onDelete: SetNull)
  currentRank       Rank?     @relation(fields: [currentRankId], references: [id], onDelete: Restrict)

  attendances       Attendance[]
  transferHistories TransferHistory[]
  certificates      Certificate[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  createdById       String?
  updatedById       String?

  createdByUser     User?   @relation("StudentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser     User?   @relation("StudentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Attendance {
  id            String    @id @default(uuid())
  studentId     String
  date          DateTime
  hoursCredited Float     @default(1.0)
  notes         String?

  student       Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?

  createdByUser User?   @relation("AttendanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser User?   @relation("AttendanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model TransferHistory {
  id              String    @id @default(uuid())
  studentId       String
  originAcademy   String
  previousSensei  String
  rankAchieved    String
  transferDate    DateTime

  student         Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?

  createdByUser   User?   @relation("TransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser   User?   @relation("TransferUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model Certificate {
  id              String    @id @default(uuid())
  studentId       String
  rankId          String
  
  associationName String
  shihanName      String
  presidentName   String
  issueDate       DateTime
  
  validationHash  String    @unique @default(uuid())

  student         Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)
  rank            Rank      @relation(fields: [rankId], references: [id], onDelete: Restrict)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdById     String?
  updatedById     String?

  createdByUser   User?   @relation("CertificateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser   User?   @relation("CertificateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}
